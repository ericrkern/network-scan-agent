[Unit]
Description=Network Pulse Dashboard - Live Device Monitor
After=network.target

[Service]
Type=simple
User=yb
Group=yb
WorkingDirectory=/usr/local/yb/.Network/dashboard
ExecStart=/usr/bin/python3 /usr/local/yb/.Network/dashboard/app.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# Listen on all IPv4 interfaces so the dashboard is reachable on LAN (e.g. 192.168.0.x) and Tailscale (100.x).
Environment=NETWORK_PULSE_BIND_ADDR=0.0.0.0
Environment=NETWORK_PULSE_PORT=5000

# Security
# NoNewPrivileges=yes blocks sudo/setuid; the Audit tab runs read_cmd_exec_audit.sh via sudo -n.
# Omit NoNewPrivileges or run the dashboard interactively if you need Audit.
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target

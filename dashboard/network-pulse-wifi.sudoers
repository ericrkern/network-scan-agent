# Example static rule (paths/user may not match your machine).
# Prefer running:  dashboard/bin/install_wifi_sudoers.sh
# That script writes /etc/sudoers.d/network-pulse-wifi using realpath + your login name.
#
# Manual install:
#   sudo install -m 440 network-pulse-wifi.sudoers /etc/sudoers.d/network-pulse-wifi
#   sudo visudo -cf /etc/sudoers.d/network-pulse-wifi
#
ekern ALL=(root) NOPASSWD: /home/ekern/Documents/network-scan-agent/dashboard/bin/scan_wifi_ssids.sh
